# Required in production. Generate a unique value; do not commit the real value.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example

# MongoDB is the application data store.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=lpu_nexus

# Django stores sessions/admin data in SQLite by default. If using SQLite in
# production, mount persistent storage and point this path at that mount.
# Prefer a managed shared SQL database for multi-instance deployments.
# SQLITE_PATH=/var/data/db.sqlite3

# Required for WebSocket chat and call notifications.
REDIS_URL=rediss://username:password@redis.example:6379/0

# Enable these only behind a trusted TLS-terminating reverse proxy.
TRUST_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
# Set these only after confirming every subdomain supports HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Required for student profile and Social Hub media uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=replace-with-your-secret

# Optional integrations.
GIPHY_API_KEY=
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=replace-with-your-secret
GEMINI_API_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
